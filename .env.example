# --- Database ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=anunay
POSTGRES_DB=risk_platform
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://postgres:anunay@localhost:5432/risk_platform

# --- Auth / JWT ---
JWT_SECRET_KEY=change-this-dev-secret-please
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS ---
# :5173 is the Vite dev server; :5530 is the suggested static-server port for
# frontend-html/ (the no-build-step HTML/JS port used to preview components);
# :5500 is VS Code's "Live Server" extension default, also used to serve it.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5530,http://127.0.0.1:5530,http://localhost:5500,http://127.0.0.1:5500

# --- SMTP (optional, for US-03 failure alert emails) ---
# Leave SMTP_HOST empty to use the console/dev email backend (emails are logged, not sent).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=no-reply@iitm-risk-platform.dev
SMTP_USE_TLS=true

# --- App ---
ENVIRONMENT=development
# Set to true only for local/dev demo seeding; never enable in production.
ENABLE_DEMO_ACCOUNTS=true
